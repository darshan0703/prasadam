# TheAtom Prasadam AI Restaurant Cashier — Backend Environment Configuration
# Copy this file to .env to configure optional cloud LLM providers.
# NOTE: The kiosk operates 100% offline using its authoritative deterministic
# conversation engine even when no cloud API keys are provided.

# Google Gemini API Configuration (Optional)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Configuration (Optional Alternative)
# Obtain from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Server Configuration
HOST=127.0.0.1
PORT=8000
x